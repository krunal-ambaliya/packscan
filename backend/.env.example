# =============================================================================
# PackScan Backend Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE: Supabase PostgreSQL (or Local PostgreSQL)
# -----------------------------------------------------------------------------
# Choose one of the following formats for Supabase:
#
# Option A: Supabase Direct Connection (Port 5432)
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?ssl=require
#
# Option B: Supabase Connection Pooler / PgBouncer (Recommended for cloud/serverless - Port 6543)
# DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?ssl=require
#
# Option C: Local PostgreSQL (Default)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/packscan_db

# -----------------------------------------------------------------------------
# Asynchronous Task Queue (Celery & Redis)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Security & JWT Token Authentication
# -----------------------------------------------------------------------------
SECRET_KEY=doca_packscan_super_secret_jwt_key_sih_2024_secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------------------
# File Storage & Uploads
# -----------------------------------------------------------------------------
UPLOAD_DIR=/tmp/packscan_uploads

# S3 / MinIO Object Storage (Optional)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=packscan-images

ENV=development
